# KalaHaat – environment variables (copy to .env and fill in real values)

# Database – defaults to SQLite if not set (great for quick demo)
DATABASE_URL=sqlite:///./kalahaat.db
# For Postgres: DATABASE_URL=postgresql://user:password@localhost:5432/kalahaat

# Auth
SECRET_KEY=change-me-in-production

# Gmail SMTP – for real OTP emails
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com/apppasswords → create an App Password
# 3. Fill in the 16-character password below (no spaces)
SMTP_USER=          # e.g. you@gmail.com
SMTP_PASSWORD=      # 16-char app password
# Leave blank to use mock mode (any 6-digit code works, demo: 123456)

# Gemini AI (optional – AI features return fallback data if not set)
GEMINI_API_KEY=
# Cloudinary (optional – falls back to local disk upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Pricing
FAIR_HOURLY_WAGE_INR=150.0
PLATFORM_FEE_INR=0.0

